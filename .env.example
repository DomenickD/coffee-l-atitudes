# PostgreSQL connection string (Railway managed Postgres in production)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/coffeelatitudes?schema=public"

# Public site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Stripe Payments (set MOCK_STRIPE="true" for zero-key local & CI testing)
MOCK_STRIPE="true"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Resend Transactional Email (falls back to structured console logging when empty)
RESEND_API_KEY=""
EMAIL_FROM="orders@coffeelatitudes.com"
