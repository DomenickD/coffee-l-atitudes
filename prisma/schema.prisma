generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
}

enum OrderType {
  PICKUP
  SHIPPING
  MIXED
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model FarmLot {
  id                 String    @id @default(cuid())
  lotCode            String    @unique
  name               String
  originRegion       String
  country            String
  latitude           String
  longitude          String
  elevation          String
  producer           String
  varietal           String
  processMethod      String
  harvestSeason      String
  cupScore           Float
  tastingNotes       String[]
  story              String
  farmGatePremiumPct Int       @default(35)
  imageUrl           String
  products           Product[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Product {
  id            String      @id @default(cuid())
  slug          String      @unique
  name          String
  subtitle      String
  description   String
  priceCents    Int
  imageUrl      String
  categoryId    String
  category      Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  farmLotId     String?
  farmLot       FarmLot?    @relation(fields: [farmLotId], references: [id], onDelete: SetNull)
  isFeatured    Boolean     @default(false)
  inStock       Boolean     @default(true)
  badge         String?
  origin        String?
  roastLevel    String?
  tastingNotes  String[]
  weightOptions String[]
  grindOptions  String[]
  sizeOptions   String[]
  orderItems    OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([categoryId])
  @@index([farmLotId])
}

model Order {
  id                    String      @id @default(cuid())
  orderNumber           String      @unique
  status                OrderStatus @default(PENDING)
  orderType             OrderType   @default(PICKUP)
  customerEmail         String
  customerName          String
  pickupNotes           String?
  subtotalCents         Int
  taxCents              Int
  totalCents            Int
  currency              String      @default("usd")
  stripeSessionId       String?     @unique
  stripePaymentIntentId String?
  isMockPayment         Boolean     @default(false)
  items                 OrderItem[]
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([customerEmail])
  @@index([status])
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName    String
  unitPriceCents Int
  quantity       Int
  lineTotalCents Int
  grindOption    String?
  weightOption   String?
  sizeOption     String?
  notes          String?
  createdAt      DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  source    String   @default("website")
  createdAt DateTime @default(now())
}
